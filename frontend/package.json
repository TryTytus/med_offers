{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "generate:api:schema": "cd ../backend && uv run python export_openapi.py",
    "generate:api": "pnpm generate:api:schema && openapi-generator-cli generate -i ../backend/openapi.json -g typescript-fetch -o app/api/generated -c openapi-generator.config.yaml --ignore-file-override openapi-generator.ignore --global-property apiDocs=false,modelDocs=false,apiTests=false,modelTests=false",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource/roboto": "^5.3.0",
    "@mui/material": "^6.5.0",
    "@mui/styled-engine-sc": "^6.4.9",
    "@mui/system": "^6.5.0",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tanstack/react-query": "^5.105.0",
    "isbot": "^5.1.36",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1",
    "styled-components": "^6.6.0"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
